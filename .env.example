# Copy to .env (git-ignored) and set your own values. Never commit .env.
# Local development only. PreProd / Prod credentials come from Sealed Secrets, not from files.

POSTGRES_USER=fresnel
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fresnel
POSTGRES_PORT=5433

# Connection string for the API and tools (pgAdmin, migrations)
DATABASE_URL=postgresql://fresnel:postgres@localhost:5433/fresnel

# --- Keycloak (mobile guard, api/src/modules/mobile/auth) ---
KEYCLOAK_ISSUER=https://keycloak.galileo.localhost/realms/galileo
# The section's Keycloak client, one for web and mobile
KEYCLOAK_CLIENT_ID=mirage
# true = the mobile routes accept calls without a token, as a fixed dev user. Ignored when NODE_ENV=production.
MOBILE_AUTH_BYPASS=true
# Node does not use the macOS keychain. If the api cannot fetch Keycloak's keys (certificate error),
# start it with the system CAs from the shell (not from this file):  NODE_OPTIONS=--use-system-ca npm run start:dev
