# Copy to .env and fill in. .env is not committed.

# --- Bundled into the app (public, never secrets) ---
# iOS simulator: http://localhost:3000 · Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SOCKET_URL=
# Keycloak (through openport). One public client (PKCE) for web and mobile.
# The app's redirect URI must be registered on it: fresnel://oauth
EXPO_PUBLIC_KEYCLOAK_ISSUER=https://keycloak.galileo.localhost/realms/galileo
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=mirage
EXPO_PUBLIC_ORACLE_URL=
# true = skip the login screen during development (fixed dev user). Pair with MOBILE_AUTH_BYPASS=true in the api.
# false = real Keycloak login; the api must then have KEYCLOAK_CLIENT_ID set.
EXPO_PUBLIC_AUTH_BYPASS=true
