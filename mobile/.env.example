# Copy to .env and fill in. .env is not committed.

# --- Bundled into the app (public, never secrets) ---
# Mock API for development: https://fresnel-mock-api.onrender.com (Swagger at /docs)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SOCKET_URL=
EXPO_PUBLIC_KEYCLOAK_ISSUER=
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=
EXPO_PUBLIC_ORACLE_URL=
# true = skip the login screen during development
EXPO_PUBLIC_AUTH_BYPASS=true
# Development only: the user the mock API acts as (X-Mock-User header), and the fixed user while AUTH_BYPASS=true.
# Users: GET /api/mock/users
EXPO_PUBLIC_MOCK_USER=ben.natanzon
