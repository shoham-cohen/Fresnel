# Copy to .env and fill in. .env is not committed.

# --- Bundled into the app (public, never secrets) ---
# Our api/ (never the mock server directly). On Android, localhost is pointed at the computer
# automatically (src/config.ts), so the same value works on the emulator and on a phone on the same Wi-Fi.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SOCKET_URL=
EXPO_PUBLIC_KEYCLOAK_ISSUER=https://keycloak.galileo.localhost/realms/galileo
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=mirage
EXPO_PUBLIC_ORACLE_URL=
# true = skip the login screen during development
EXPO_PUBLIC_AUTH_BYPASS=true
# The user the mock API acts as (sent as X-Mock-User). Must be a mock user id, or the mock answers 401.
EXPO_PUBLIC_MOCK_USER=user-bob
